# Copy this file to .env and replace every password before starting.
# Never commit the real .env file.

# Database
DB_NAME=paintings_hall
DB_USER=paintings
DB_PASSWORD=change_this_password

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_password

# Host ports (change these if a port is already in use)
APP_PORT=8081
GRAFANA_PORT=3000
DB_PORT=5432
