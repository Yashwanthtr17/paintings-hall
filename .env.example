# Copy this file to .env and replace every password before starting.
# Never commit the real .env file.

# Database
DB_NAME=paintings_hall-db
DB_USER=ENTER_YOUR_USER_NAME
DB_PASSWORD=ENTER_YOUR_PASSWORD

# Grafana
GRAFANA_ADMIN_USER=ENTER_YOUR_USER_NAME
GRAFANA_ADMIN_PASSWORD=ENTER_YOUR_PASSWORD

# Host ports (change these if a port is already in use)
APP_PORT=8081
GRAFANA_PORT=3000
DB_PORT=5432
