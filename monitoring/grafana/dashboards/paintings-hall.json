    {
      "id": 10,
      "type": "timeseries",
      "title": "Collection Growth (cumulative)",
      "description": "Cumulative number of paintings over time.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "paintings-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "paintings-postgres" },
          "rawSql": "SELECT date_trunc('day', created_at) AS time, SUM(COUNT(*)) OVER (ORDER BY date_trunc('day', created_at)) AS \"Total paintings\" FROM paintings GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Paintings Added per Day",
      "description": "New paintings added each day. Respects the dashboard time range.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "postgres", "uid": "paintings-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "paintings-postgres" },
          "rawSql": "SELECT $__timeGroup(created_at, '1d') AS time, COUNT(*) AS \"Paintings\" FROM paintings WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Paintings by Artist",
      "description": "Number of paintings per artist.",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "paintings-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "paintings-postgres" },
          "rawSql": "SELECT artist AS \"Artist\", COUNT(*) AS \"Paintings\" FROM paintings GROUP BY artist ORDER BY 2 DESC LIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "xField": "Artist",
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "barRadius": 0,
        "fullHighlight": false,
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "xTickLabelRotation": 0,
        "xTickLabelMaxLength": 0,
        "xTickLabelSpacing": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "piechart",
      "title": "Paintings by Century",
      "description": "Distribution of paintings by century.",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "postgres", "uid": "paintings-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "paintings-postgres" },
          "rawSql": "SELECT ((year / 100) * 100)::text || 's' AS \"Century\", COUNT(*) AS \"Paintings\" FROM paintings WHERE year IS NOT NULL GROUP BY 1 ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "values": ["value"]
        },
        "tooltip": { "mode": "single", "sort": "none" },
        "reduceOptions": { "values": true, "calcs": [], "fields": "/^Paintings$/" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Collection Completeness",
      "description": "Share of paintings that have an image, a description, and a year.",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "postgres", "uid": "paintings-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "paintings-postgres" },
          "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE image_url IS NOT NULL AND image_url <> '') / COUNT(*), 0) AS \"Images\", ROUND(100.0 * COUNT(*) FILTER (WHERE description IS NOT NULL AND description <> '') / COUNT(*), 0) AS \"Descriptions\", ROUND(100.0 * COUNT(*) FILTER (WHERE year IS NOT NULL) / COUNT(*), 0) AS \"Years\" FROM paintings",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": { "values": true, "calcs": [], "fields": "" },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "green", "value": 90 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
