{
  "uid": "paintings-hall-overview",
  "title": "Paintings Hall Overview",
  "tags": ["paintings-hall"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Paintings",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "paintings-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "paintings-postgres" },
          "rawSql": "SELECT COUNT(*) AS value FROM paintings",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Paintings Added per Day",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "paintings-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "paintings-postgres" },
          "rawSql": "SELECT $__timeGroup(created_at, '1d') AS time, COUNT(*) AS value FROM paintings GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Paintings by Artist",
      "gridPos": { "h": 9, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "paintings-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "paintings-postgres" },
          "rawSql": "SELECT artist AS \"Artist\", COUNT(*) AS \"Paintings\" FROM paintings GROUP BY artist ORDER BY 2 DESC LIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": { "min": 0, "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent Paintings",
      "gridPos": { "h": 9, "w": 18, "x": 6, "y": 8 },
      "datasource": { "type": "postgres", "uid": "paintings-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "paintings-postgres" },
          "rawSql": "SELECT title AS \"Title\", artist AS \"Artist\", year AS \"Year\", created_at AS \"Added\" FROM paintings ORDER BY created_at DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": []
      }
    }
  ],
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "fiscalYearStartMonth": 0,
  "liveNow": false
}
