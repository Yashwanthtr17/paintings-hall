          "datasource": { "type": "postgres", "uid": "paintings-postgres" },
          "rawSql": "SELECT title AS \"Title\", artist AS \"Artist\", year AS \"Year\", created_at AS \"Added\" FROM paintings WHERE year IS NOT NULL ORDER BY year ASC LIMIT 10",
